{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "anleggstorget.no" }],
      "destination": "https://www.anleggstorget.no/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync-nasta",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-hesselberg",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/sync-oslomaskin",
      "schedule": "30 6 * * *"
    }
  ],
  "functions": {
    "app/api/cron/sync-nasta/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-hesselberg/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-rockmann/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-oslomaskin/route.ts": {
      "maxDuration": 300
    }
  }
}
